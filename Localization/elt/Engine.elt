[LinkerUpdateCommandlet]
HelpCmd=linkerupdate
HelpWebLink="https://www.oldunreal.com/wiki/index.php?title=Commandlet"
HelpOneLiner="Προσθέτει αυτόματα όλα τα αθροίσματα ελέγχου των αρχείων του φακέλου στο SHALinkerCache.ini. Χρησιμοποιείται από το anticheat UnrealIntegrity."
HelpUsage="linkerupdate <filename>"
HelpParm[0]="<filename>"
HelpDesc[0]="Το αρχείο του οποίου το άθροισμα ελέγχου θα υπολογιστεί για μελλοντική αποθήκευση."

[SHAUpdateCommandlet]
HelpCmd=shaupdate
