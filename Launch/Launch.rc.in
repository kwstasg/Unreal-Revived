#include <winres.h>
#include "@UE1_227K_SDK_ROOT@/Launch/Src/Res/LaunchRes.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDICON_Mainframe2 ICON "@CMAKE_CURRENT_SOURCE_DIR@/../branding/UnrealRevived.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,6,1,0
 PRODUCTVERSION 0,6,1,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Kwstasg - Kostas Giannakakis"
   VALUE "FileDescription", "@description@"
   VALUE "FileVersion", "0.6.1.0"
   VALUE "InternalName", "@executable@"
   VALUE "OriginalFilename", "@executable@.exe"
   VALUE "ProductName", "Unreal Revived"
   VALUE "ProductVersion", "0.6.1"
   VALUE "LegalCopyright", "Unreal Revived modifications: Kostas Giannakakis. Unreal engine: Epic Games, Inc.; OldUnreal contributions retained."
   VALUE "Comments", "https://github.com/kwstasg/Unreal-Revived"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
IDDIALOG_Splash DIALOGEX 0, 0, 191, 65
STYLE DS_SETFONT | DS_SETFOREGROUND | DS_CENTER | WS_POPUP
EXSTYLE WS_EX_TOOLWINDOW
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
 CONTROL "", IDC_Logo, "Static", SS_BITMAP, 0, 0, 15, 13
END
